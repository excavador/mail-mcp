{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "mail-mcp values",
  "description": "Strict: a typo in a values file should fail the render, not be silently ignored and leave you wondering why a setting had no effect.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "accounts",
    "service",
    "auth",
    "proxy"
  ],
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1,
      "description": "At most 1 steady-state replica: the cache is a node-local SQLite database and history an RWO PVC. A rolling update briefly runs a second pod (maxSurge 1) on the same node; a Lease keeps the background jobs on one of them."
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "repository"
      ],
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "description": "Empty means the chart's appVersion. Pin it to upgrade deliberately rather than whenever the chart is republished."
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "accounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1,
          "description": "Required. The accounts file and password files are never literals in values: they would end up in a values file, in git, and in `helm get values` output."
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "port",
        "adminPort"
      ],
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "The Service port of the read proxy (container port 8080)."
        },
        "adminPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "The Service port of the admin proxy (container port 8082). Must differ from port."
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuerUrl",
        "readResourceUrl",
        "adminResourceUrl"
      ],
      "properties": {
        "issuerUrl": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https://[^#\\s]+$",
          "description": "The issuer's own URL, exactly as it appears in a token's `iss`. https, no fragment."
        },
        "readResourceUrl": {
          "type": "string",
          "minLength": 1,
          "pattern": "^$|^https://[^/?#\\s]+/[^?#\\s]*[^/?#\\s]$",
          "description": "The read endpoint's EXTERNAL URL: the RFC 8707 resource indicator, and the `aud` the read proxy requires. Must match this resource's id in the issuer's policy and the public URL, byte for byte. https, a path, no trailing slash."
        },
        "adminResourceUrl": {
          "type": "string",
          "minLength": 1,
          "pattern": "^$|^https://[^/?#\\s]+/[^?#\\s]*[^/?#\\s]$",
          "description": "The admin endpoint's EXTERNAL URL, the same way. Must differ from readResourceUrl; neither path inside the other."
        },
        "scope": {
          "type": "string",
          "description": "Advertised in the PRM's scopes_supported and the 401 challenge's scope; never checked. Empty omits both fields."
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storageClass": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "forceRecreate": {
      "type": "boolean",
      "description": "Use the Recreate strategy even when history.existingClaim is set. Needed for a release that bumps the cache schemaVersion."
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingClaim": {
          "type": "string",
          "description": "Optional. When empty, an emptyDir is used and history is discarded on restart. In production this should be a durable, backed-up PVC."
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "client",
            "elicitation"
          ],
          "description": "client: approval is the client's tool-approval prompt, capped per apply. elicitation: MCP forms. See anthropics/claude-code#98978."
        }
      }
    },
    "pdfExtractor": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional PDF text sidecar. Off by default.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "registry",
            "repository"
          ],
          "properties": {
            "registry": {
              "type": "string",
              "minLength": 1
            },
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "description": "Empty means the chart's appVersion."
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object",
              "required": [
                "memory"
              ],
              "description": "A memory limit is required: it is the container-level bound on a parser handling untrusted files. It must be at least 464Mi (the helper's 400 MB address-space cap plus 64Mi; the chart refuses a smaller value written in Mi): below that the kernel OOM-kills pdftotext on large files, which looks like a bad file."
            }
          },
          "required": [
            "limits"
          ]
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "deploymentAnnotations": {
      "type": "object",
      "description": "Annotations on the Deployment itself. Reloader reads them here, not on the pod template.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image"
      ],
      "description": "The sluis resource-proxy sidecars: two containers (read, admin) from one image.",
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "description": "REQUIRED (the chart refuses an empty one): the chart has no default version of a sidecar built elsewhere."
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[0-9a-f]{64})?$",
              "description": "REQUIRED (the chart refuses an empty one): sha256:<64 hex>."
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "type": "array",
          "description": "NetworkPolicyPeer list admitted on the proxies' ports. Required non-empty while enabled."
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dns": {
              "type": "array"
            },
            "https": {
              "type": "array"
            },
            "imap": {
              "type": "array",
              "description": "IMAP upstreams, verbatim NetworkPolicyEgressRule list."
            }
          }
        },
        "extraEgress": {
          "type": "array",
          "description": "Verbatim NetworkPolicyEgressRule list: an in-cluster IMAP bridge, the Kubernetes API server for the Lease."
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "parentRefs": {
          "type": "array"
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object"
        },
        "labels": {
          "type": "object"
        },
        "timeouts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "request": {
              "type": "string",
              "pattern": "^([0-9]+(h|m|s|ms))*$"
            }
          }
        },
        "sessionAffinity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "headerName": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
